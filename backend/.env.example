# POS-MOBILE Backend Configuration

# App
APP_NAME=POS-MOBILE API
APP_VERSION=1.0.0
DEBUG=true

# Database (SQLite for local/Termux)
DATABASE_URL=sqlite+aiosqlite:///./pos_mobile.db
DATABASE_ECHO=false

# Server
HOST=0.0.0.0
PORT=8000

# Data directory (Termux/Android)
DATA_DIR=/data/data/com.termux/files/home/pos-mobile-data

# CORS Origins (for local file:// access)
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "file://", "null"]